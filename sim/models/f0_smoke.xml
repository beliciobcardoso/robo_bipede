<!--
  F0 smoke-test model: a box "torso" on a free joint with one 4-joint leg made of boxes
  (hip pitch, knee, ankle pitch, ankle roll), position servos, falling onto a floor.
  Rough SG90-like numbers; only meant to exercise contacts, joints and actuators.
  Units: metres, kilograms, seconds (MuJoCo default).
-->
<mujoco model="f0_smoke">
  <option timestep="0.002"/>
  <!-- Frame the default viewer camera on the robot (it is only ~0.2 m tall). -->
  <statistic center="0 0 0.1" extent="0.25"/>
  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <global azimuth="135" elevation="-20"/>
  </visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0 0 0" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.3 0.35 0.4" width="256" height="256"/>
    <material name="floor" texture="grid" texrepeat="20 20" reflectance="0.1"/>
    <material name="servo" rgba="0.2 0.35 0.8 1"/>
    <material name="link" rgba="0.85 0.85 0.85 1"/>
  </asset>
  <default>
    <joint damping="0.05" armature="0.0005" range="-90 90"/>
    <geom contype="1" conaffinity="1" friction="0.8 0.02 0.001"/>
    <position kp="1.5" forcerange="-0.18 0.18" ctrlrange="-1.57 1.57"/>
  </default>
  <worldbody>
    <light name="sun" pos="0.3 -0.3 1" dir="-0.3 0.3 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="1 1 0.1" material="floor"/>
    <body name="torso" pos="0 0 0.20">
      <freejoint/>
      <geom type="box" size="0.03 0.05 0.03" mass="0.20" material="servo"/>
      <body name="thigh" pos="0 0 -0.03">
        <joint name="hip_pitch" axis="0 1 0"/>
        <geom type="box" size="0.012 0.016 0.0225" pos="0 0 -0.0225" mass="0.03" material="link"/>
        <body name="shin" pos="0 0 -0.045">
          <joint name="knee" axis="0 1 0"/>
          <geom type="box" size="0.012 0.016 0.0225" pos="0 0 -0.0225" mass="0.03" material="link"/>
          <body name="ankle" pos="0 0 -0.045">
            <joint name="ankle_pitch" axis="0 1 0"/>
            <geom type="box" size="0.012 0.012 0.008" pos="0 0 -0.008" mass="0.015" material="link"/>
            <body name="foot" pos="0 0 -0.016">
              <joint name="ankle_roll" axis="1 0 0"/>
              <geom type="box" size="0.035 0.0225 0.004" pos="0 0 -0.004" mass="0.02" material="link"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="hip_pitch" joint="hip_pitch"/>
    <position name="knee" joint="knee"/>
    <position name="ankle_pitch" joint="ankle_pitch"/>
    <position name="ankle_roll" joint="ankle_roll"/>
  </actuator>
</mujoco>
